{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UniGlobe Access Guard",
  "version": "0.1.0",
  "identifier": "com.uniglobe.accessguard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "vite --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "vite build"
  },
  "app": {
    "windows": [
      {
        "title": "UniGlobe Access Guard",
        "width": 1100,
        "height": 760,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "UniGlobe",
    "category": "Utility",
    "shortDescription": "Consent wrapper for Chrome Remote Desktop.",
    "longDescription": "UniGlobe Access Guard keeps Chrome Remote Desktop access under local employee approval by controlling the Windows chromoting service or macOS Chrome Remote Desktop launch agent.",
    "copyright": "Copyright (c) 2026 UniGlobe",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
